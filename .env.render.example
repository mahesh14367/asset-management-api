# Server Configuration
PORT=8000
NODE_ENV=production

# Database Configuration
MONGODB_URI=mongodb+srv://your_user:your_password@cluster.mongodb.net/asset-management

# JWT Configuration
JWT_ACCESS_SECRET=your-32-character-access-secret-change-in-production
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_SECRET=your-32-character-refresh-secret-change-in-production
JWT_REFRESH_EXPIRE=30d
JWT_REFRESH_COOKIE_MAXAGE_MS=604800000

# Security
BCRYPT_SALT_ROUNDS=12

# CORS Configuration
CORS_ORIGIN=https://your-frontend.onrender.com

# Storage Configuration - MinIO on Render
STORAGE_DRIVER=minio
# IMPORTANT: Use the full Render service URL (no :9000 or :9001)
# Get this from your MinIO service page in Render dashboard
MINIO_ENDPOINT=https://your-minio-service-name.onrender.com
MINIO_BUCKET=assets
MINIO_ACCESS_KEY=your_minio_username  # Copy from MinIO service env vars
MINIO_SECRET_KEY=your_minio_password_at_least_8_chars  # Copy from MinIO service env vars

# Alternative: AWS S3 (if not using MinIO)
# STORAGE_DRIVER=s3
# AWS_S3_BUCKET=your-bucket-name
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# Alternative: Local Storage (not recommended for Render)
# STORAGE_DRIVER=local
# LOCAL_UPLOAD_DIR=/opt/render/project/uploads
# LOCAL_BASE_URL=https://your-api.onrender.com
